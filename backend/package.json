{
  "name": "orpind-backend",
  "version": "1.0.0",
  "description": "Orpind E-Commerce Backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node dev.js",
    "dev:nodemon": "nodemon dev.js",
    "worker": "node src/workers/index.js",
    "seed": "node src/database/seeders/index.js",
    "seed:destroy": "node src/database/seeders/destroy.js",
    "test": "node --experimental-vm-modules node_modules/jest-cli/bin/jest.js --forceExit --detectOpenHandles",
    "test:unit": "jest --testPathPattern=tests/unit --forceExit",
    "test:integration": "jest --testPathPattern=tests/integration --forceExit",
    "test:e2e": "jest --testPathPattern=tests/e2e --forceExit",
    "test:coverage": "jest --coverage --forceExit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "migrate": "node src/database/migrations/run.js"
  },
  "dependencies": {
    "@sentry/node": "^10.68.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.1.0",
    "cloudinary": "^2.0.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "pdfkit": "^0.15.0",
    "rate-limit-redis": "^4.2.0",
    "razorpay": "^2.9.4",
    "resend": "^4.0.0",
    "sanitize-html": "^2.13.1",
    "stripe": "^22.3.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0",
    "winston": "^3.14.2",
    "winston-daily-rotate-file": "^5.0.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.0.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
