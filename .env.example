# Environment Variables — Copy to .env.local

# ─── Database ──────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/orpind?schema=public"

# ─── Authentication ────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-this"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Site ──────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Orpind"
NEXT_PUBLIC_SITE_DESCRIPTION="Premium Organic Spices & Grains from Punjab"

# ─── Razorpay ──────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─── Email (Resend) ────────────────────────────
RESEND_API_KEY=""
SMTP_FROM="hello@orpind.com"

# ─── File Storage (AWS S3 / Cloudflare R2) ────
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="orpind-uploads"
CDN_URL=""

# ─── Sentry ────────────────────────────────────
SENTRY_DSN=""

# ─── Company Details (for invoices) ───────────
COMPANY_GSTIN="03AABCO1234F1Z5"
COMPANY_PAN="AABCO1234F"

# ─── Redis (optional, for rate limiting) ───────
REDIS_URL=""

# ─── Analytics ─────────────────────────────────
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=""

# ─── Shipping ──────────────────────────────────
SHIPPING_FREE_THRESHOLD="999"
DEFAULT_ORIGIN_STATE="Punjab"
